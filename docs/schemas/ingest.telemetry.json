{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "message_id", "truck_id", "timestamp", "position", "speed_kmh", "heading_deg", "info"],
  "properties": {
    "type": {"const": "telemetry"},
    "version": {"const": 1},
    "message_id": {"type": "string", "minLength": 1},
    "truck_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "timestamp": {"type": "string"},
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "speed_kmh": {"type": "number", "minimum": 0},
    "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "info": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 512}
    }
  }
}
